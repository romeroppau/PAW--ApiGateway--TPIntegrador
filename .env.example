# Dónde se corre: local, dev o ci. Las semillas (datos de prueba) solo se cargan en esos tres.
ENTORNO=local
MYSQL_ROOT_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=

BACKEND_DB_USER=
BACKEND_DB_PASSWORD=
INVENTARIO_DB_USER=
INVENTARIO_DB_PASSWORD=
PACIENTES_DB_USER=
PACIENTES_DB_PASSWORD=
ADOPCIONES_DB_USER=
ADOPCIONES_DB_PASSWORD=
REPORTES_DB_USER=
REPORTES_DB_PASSWORD=

# Token de las llamadas internas entre módulos (Pacientes -> Inventario). Generarlo con: openssl rand -hex 32
INTERNAL_TOKEN=

# Tareas programadas (GitHub Actions las llama con el header X-Tarea-Token). openssl rand -hex 32
TAREAS_TOKEN=

# WhatsApp (envío real de avisos, solo Backend). En local no hacen falta: con ENTORNO=local el envío es simulado.
# WHATSAPP_NUMERO_ID es el "Identificador del número de teléfono" de Meta (no el número en sí).
WHATSAPP_TOKEN=
WHATSAPP_NUMERO_ID=
WHATSAPP_PLANTILLA=aviso_huellavet
WHATSAPP_IDIOMA=es_AR
# Opcional: versión de la Graph API (por defecto v25.0).
WHATSAPP_API_VERSION=

# Mercado Pago (pago de la tienda, solo Inventario). SIEMPRE credenciales de prueba (vendedor de prueba).
# En local no hacen falta: con ENTORNO=local el pago es simulado.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Dirección pública del sitio, por ejemplo https://huellavet-la25-dev.vercel.app (sin "/" al final).
SITIO_URL=

DB_SSL_CA=

JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
